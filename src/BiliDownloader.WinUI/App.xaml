<Application x:Class="BiliDownloader.WinUI.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:Microsoft.UI.Xaml.Controls">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><controls:XamlControlsResources /></ResourceDictionary.MergedDictionaries>
   <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
   <x:Double x:Key="NavigationViewTopPaneHeight">40</x:Double>
   <x:Double x:Key="ExpanderMinHeight">36</x:Double>
   <Thickness x:Key="ButtonPadding">10,4,10,4</Thickness>
   <Thickness x:Key="ExpanderContentPadding">12</Thickness>
   <Thickness x:Key="ExpanderHeaderPadding">12,0,0,0</Thickness>
   <Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/></Style>
   <Color x:Key="SystemAccentColor">#0788BA</Color>
   <SolidColorBrush x:Key="BrandBrush" Color="#0788BA" />
  </ResourceDictionary>
 </Application.Resources>
</Application>
